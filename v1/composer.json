{
    "name": "partops/inventory-tracker",
    "description": "Parts Inventory Tracker with QR scanning and core charge management",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.1",
        "ext-pdo": "*",
        "ext-json": "*",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "PartOps\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PartOps\\Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    }
}
