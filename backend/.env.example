# Database Configuration
DB_HOST=127.0.0.1
DB_NAME=partops
DB_USER=your_db_user
DB_PASS=your_db_password

# Application
APP_ENV=production
APP_DEBUG=false

# LDAP Configuration
# LDAP Server (use ldap:// or ldaps:// prefix)
LDAP_HOST=ldap://your-domain-controller.local
LDAP_PORT=389

# Use SSL/TLS
LDAP_USE_SSL=false
LDAP_USE_TLS=false

# Base DN for searching users
# Example: DC=company,DC=local
LDAP_BASE_DN=DC=yourdomain,DC=local

# User search settings
LDAP_USER_SEARCH_ATTR=sAMAccountName
LDAP_USER_FILTER=(&(objectClass=user)(objectCategory=person))

# Security Group (optional - leave empty to allow all authenticated users)
LDAP_REQUIRED_GROUP=

# Group attribute to check
LDAP_GROUP_ATTR=memberOf

# Allowed groups (comma-separated DNs). Leave empty to allow all authenticated LDAP users.
# Example: CN=PAMAdmin,OU=Groups,DC=yourdomain,DC=local,CN=PAMUser,OU=Groups,DC=yourdomain,DC=local
LDAP_ALLOWED_GROUPS=

# Role mapping groups (full DN)
LDAP_ADMIN_GROUP=CN=PAMAdmin,OU=Groups,DC=yourdomain,DC=local
LDAP_USER_GROUP=CN=PAMUser,OU=Groups,DC=yourdomain,DC=local

# Service account for LDAP searches (optional)
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=

# Session lifetime in seconds (default: 3600 = 1 hour)
SESSION_LIFETIME=3600
